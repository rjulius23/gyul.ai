---
import { interests, profile } from '../lib/content';
import { createBrief, MAX_CONTEXT_LENGTH } from '../lib/brief';
import Arrow from './Arrow.astro';
const draft = createBrief('strategy');
---

<section id="contact" class="contact-section" aria-labelledby="contact-title">
  <div class="wrap contact-grid">
    <div class="contact-copy">
      <p class="eyebrow section-label">06 / YOUR NEXT USEFUL STEP</p><h2
        id="contact-title"
      >
        Something<br />on your <em>mind?</em>
      </h2><p>
        A workflow that’s stuck. A team that’s curious.<br />An idea worth
        making real.<br />Let’s find a sensible place to start.
      </p><a class="text-link direct-email" href={`mailto:${profile.email}`}
        >Prefer a simple email? <Arrow /></a
      ><span class="contact-note eyebrow">NO PITCH DECK REQUIRED.</span><div
        class="contact-decoration"
        aria-hidden="true"
      >
        <span>+</span><i></i><span>↗</span>
      </div>
    </div>
    <div class="brief-composer" data-brief>
      <div class="brief-heading">
        <span class="eyebrow">LET’S MAKE THE FIRST MESSAGE EASY.</span><Arrow />
      </div>
      <div data-brief-fields hidden>
        <label for="interest">What would you like to explore?</label>
        <select id="interest" name="interest" data-interest-select
          >{
            interests.map((interest) => (
              <option value={interest.id}>{interest.label}</option>
            ))
          }</select
        >
        <label for="brief-context"
          >A little context <span>(optional)</span></label
        >
        <textarea
          id="brief-context"
          name="context"
          rows="3"
          maxlength={MAX_CONTEXT_LENGTH}
          placeholder="A bottleneck, a workflow, or something your team wants to learn…"
          aria-describedby="context-privacy"
          data-brief-context></textarea>
        <p id="context-privacy" class="input-note">
          Keep confidential information out. This stays in your browser until
          you choose to share it.
        </p>
        <label for="brief-output" class="draft-label">Your email draft</label>
        <textarea id="brief-output" rows="5" readonly data-brief-output
          >{draft.body}</textarea
        >
        <div class="brief-actions">
          <a class="button" href={draft.href} data-email-draft
            >Open email draft <Arrow /></a
          ><button class="copy-button" type="button" data-copy-brief
            >Copy brief <span aria-hidden="true">⧉</span></button
          >
        </div>
        <p
          class="brief-status"
          role="status"
          aria-live="polite"
          data-brief-status
        >
          Nothing is submitted by this page.
        </p>
      </div>
      <noscript
        ><p class="noscript-contact">
          Tell me a little about your team and what you’d like to explore.
          There’s no form to submit—just a conversation.
        </p><a class="button" href={`mailto:${profile.email}`}
          >Email Gyula <Arrow /></a
        ></noscript
      >
      <p class="brief-footer">
        Your email app sends the message. This site doesn’t collect it.
      </p>
    </div>
  </div>
</section>
<style>
  .contact-section {
    background: var(--signal);
    padding-block: clamp(3.5rem, 6.5vw, 6rem);
  }
  .contact-grid {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 5rem;
    align-items: start;
  }
  .contact-copy {
    position: relative;
  }
  .contact-copy .section-label {
    color: #4b5130;
  }
  .contact-copy h2 {
    margin-top: 2.2rem;
    font-size: clamp(3rem, 6.2vw, 6rem);
  }
  .contact-copy > p:not(.eyebrow) {
    margin-top: 1.8rem;
    font-size: 0.92rem;
    line-height: 1.9;
    color: #424927;
  }
  .direct-email {
    margin-top: 1.5rem;
    font-size: 0.8rem;
    border-bottom: 1px solid #909647;
  }
  .contact-note {
    color: #4b5130;
    margin-top: 2rem;
    font-size: 0.55rem;
  }
  .contact-decoration {
    margin-top: 2.5rem;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    width: 75%;
    font-size: 2.3rem;
    line-height: 1;
  }
  .contact-decoration i {
    height: 1px;
    background: #adb342;
    flex: 1;
  }
  .brief-composer {
    background: #f6f5e8;
    border: 1px solid #c5ca70;
    border-radius: 5px;
    padding: 1.6rem;
    box-shadow: 0 6px 22px rgb(79 85 28 / 0.04);
    min-width: 0;
  }
  .brief-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 1.2rem;
    margin-bottom: 1.2rem;
    border-bottom: 1px solid #d6d8bd;
  }
  .brief-heading .eyebrow {
    font-size: 0.55rem;
    line-height: 1.7;
  }
  label {
    display: block;
    font-size: 0.73rem;
    margin: 1.1rem 0 0.5rem;
  }
  label > span {
    color: #6a6e53;
  }
  select,
  textarea {
    display: block;
    width: 100%;
    border: 1px solid #91977a;
    border-radius: 3px;
    padding: 0.8rem;
    background: #fcfcf3;
    color: var(--ink);
    font-size: 0.76rem;
    line-height: 1.6;
  }
  /* Isolate native control layout: WebKit otherwise propagates stale option-width overflow after text resizing. */
  [data-brief-fields] {
    contain: layout;
  }
  select {
    padding-right: 2rem;
    min-height: 47px;
    text-overflow: ellipsis;
  }
  textarea {
    resize: vertical;
    min-height: 80px;
  }
  textarea::placeholder {
    color: #747962;
    opacity: 1;
  }
  .input-note {
    font-size: 0.61rem;
    color: #60664e;
    line-height: 1.7;
    margin-top: 0.5rem;
  }
  .draft-label {
    font: 0.55rem var(--mono);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-top: 1.4rem;
    color: #61684f;
  }
  #brief-output {
    background: #eeefdf;
    border-color: #d1d5bd;
    font: 0.63rem/1.8 var(--mono);
    min-height: 115px;
  }
  .brief-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    margin-top: 1.2rem;
  }
  .brief-actions .button {
    font-size: 0.72rem;
    min-height: 44px;
    padding: 0.75rem 1rem;
    gap: 0.8rem;
  }
  .copy-button {
    background: transparent;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.69rem;
    min-height: 44px;
    padding: 0.4rem 0.1rem;
  }
  .copy-button > span {
    font-size: 1rem;
  }
  .copy-button:hover {
    text-decoration: underline;
    text-underline-offset: 0.3rem;
  }
  .brief-status {
    min-height: 2.5rem;
    font-size: 0.61rem;
    color: #596246;
    line-height: 1.6;
    padding-top: 0.75rem;
  }
  .brief-footer {
    font-size: 0.56rem;
    color: #686f55;
    border-top: 1px solid #d6d8bd;
    padding-top: 1rem;
    line-height: 1.7;
  }
  .noscript-contact {
    font-size: 0.85rem;
    margin-bottom: 1.5rem;
  }
  noscript .button {
    margin-bottom: 1.5rem;
  }
  @media (max-width: 900px) {
    .contact-grid {
      gap: 2.5rem;
      grid-template-columns: 1fr 1fr;
    }
    .brief-composer {
      padding: 1.25rem;
    }
  }
  @media (max-width: 680px) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .contact-copy h2 {
      font-size: clamp(3.5rem, 13vw, 5rem);
    }
    .contact-decoration {
      display: none;
    }
    .contact-note {
      margin-top: 1.5rem;
    }
    .brief-composer {
      padding: 1.1rem;
    }
    select,
    textarea {
      font-size: 1rem;
    }
    #brief-output {
      font-size: 0.66rem;
    }
    .brief-actions {
      gap: 0.6rem;
    }
    .brief-actions .button {
      font-size: 0.68rem;
      gap: 0.6rem;
      padding-inline: 0.8rem;
    }
    .copy-button {
      font-size: 0.65rem;
    }
  }
</style>
