---
import Arrow from './Arrow.astro';
import { scenarios, stageLabels } from '../lib/workflows';
const first = scenarios[0]!;
const stage = first.stages[0];
---

<section
  id="playground"
  class="playground"
  aria-labelledby="playground-title"
  data-playground
>
  <div class="wrap lab-wrap">
    <div class="lab-topline">
      <p class="eyebrow section-label">02 / THE PLAYGROUND</p><span
        class="lab-disclosure"
        ><span class="dot" aria-hidden="true"></span> ILLUSTRATIVE DEMO · NO LIVE
        AI</span
      >
    </div>
    <div class="lab-heading">
      <h2 id="playground-title">
        Follow the work.<br />Not the <em>hype.</em>
      </h2><p>
        See how context, agents, and human judgement fit together. Three small
        examples. A few deliberate boundaries.<br /><span
          >Every input is synthetic. Nothing is sent anywhere.</span
        >
      </p>
    </div>
    <div
      class="scenario-tabs"
      role="tablist"
      aria-label="Workflow scenario"
      data-scenario-tabs
      hidden
    >
      {
        scenarios.map((scenario, index) => (
          <button
            type="button"
            role="tab"
            id={`scenario-${scenario.id}`}
            aria-selected={index === 0 ? 'true' : 'false'}
            aria-controls="workflow-panel"
            tabindex={index === 0 ? 0 : -1}
            data-scenario-id={scenario.id}
          >
            <span class="tab-number" aria-hidden="true">
              0{index + 1}
            </span>
            {scenario.label}
            <Arrow />
          </button>
        ))
      }
    </div>
    <noscript
      ><p class="no-script-note">
        Static example: research synthesis. Enable JavaScript to step through
        all three local demonstrations.
      </p></noscript
    >
    <div id="workflow-panel" class="workflow-panel" data-workflow-panel>
      <div class="workflow-heading">
        <span class="eyebrow" data-scenario-intent>{first.intent}</span><span
          class="eyebrow local-label"
          ><span class="dot" aria-hidden="true"></span> RUNS LOCALLY</span
        >
      </div>
      <ol class="flow-path" aria-label="Workflow stages">
        {
          stageLabels.map((label, index) => (
            <li
              data-flow-node={index}
              data-active={index === 0 ? 'true' : 'false'}
            >
              <button
                type="button"
                data-step={index}
                aria-current={index === 0 ? 'step' : undefined}
                disabled
              >
                <span class="node-label">{label}</span>
                {index === 2 && (
                  <span class="gate-symbol" aria-hidden="true">
                    ⊣
                  </span>
                )}
              </button>
            </li>
          ))
        }
      </ol>
      <div class="lab-content">
        <div class="stage-explanation">
          <p class="eyebrow stage-count" data-stage-count>01 / THE INPUT</p>
          <h3 data-stage-title>{stage.heading}</h3>
          <p class="stage-summary" data-stage-summary>{stage.summary}</p>
          <ul class="stage-bullets" data-stage-bullets>
            {stage.bullets.map((item) => <li>{item}</li>)}
          </ul>
          <button
            class="button button--light approve-button"
            type="button"
            data-approve
            hidden>Approve sample draft <Arrow direction="right" /></button
          >
        </div>
        <div class="artifact">
          <div class="artifact-bar">
            <span class="artifact-dots" aria-hidden="true"
              ><i></i><i></i><i></i></span
            ><span data-artifact-name>{stage.artifactTitle}</span><span
              class="artifact-sample">SAMPLE</span
            >
          </div>
          <pre><code data-artifact>{stage.artifact}</code></pre>
          <div class="artifact-footer">
            <span>AUTHORED EXAMPLE</span><span data-artifact-state
              >INPUT / 01</span
            >
          </div>
        </div>
      </div>
      <div class="lab-controls" data-lab-controls hidden>
        <div class="playback-controls">
          <button type="button" class="button button--light run-button" data-run
            ><span data-run-label>Run demo</span><Arrow
              direction="right"
            /></button
          ><button type="button" class="step-button" data-next
            >Next step <Arrow direction="right" /></button
          ><button type="button" class="reset-button" data-reset>Reset</button>
        </div>
        <p
          class="workflow-status"
          aria-live="polite"
          aria-atomic="true"
          data-workflow-status
        >
          Input ready. Explore at your own pace.
        </p>
      </div>
    </div>
    <noscript
      ><div class="static-stages">
        <p class="eyebrow">READ THE REST OF THE ILLUSTRATIVE WORKFLOW</p>{
          first.stages.slice(1).map((item) => (
            <details>
              <>
                <summary>{item.heading}</summary>
                <p>{item.summary}</p>
                <pre>{item.artifact}</pre>
              </>
            </details>
          ))
        }
      </div></noscript
    >
    <div class="lab-bottom">
      <p>Good automation knows when to stop.</p><span
        >Local demonstration only. Real systems need server-side permissions and
        review controls.</span
      >
    </div>
  </div>
</section>
<style>
  .playground {
    background: var(--dark);
    color: var(--paper);
    padding-block: clamp(3.5rem, 6.8vw, 6.5rem);
    position: relative;
  }
  .lab-wrap {
    container: lab / inline-size;
  }
  .lab-topline {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }
  .lab-topline .section-label {
    color: var(--dark-muted);
  }
  .lab-disclosure {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font: 0.58rem var(--mono);
    color: var(--signal);
    letter-spacing: 0.05em;
  }
  .lab-heading {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 3rem;
    margin: 2.2rem 0 3rem;
  }
  h2 em {
    color: var(--signal);
  }
  .lab-heading > p {
    max-width: 25rem;
    color: var(--dark-muted);
    font-size: 0.9rem;
    line-height: 1.8;
  }
  .lab-heading > p span {
    display: inline-block;
    font-size: 0.72rem;
    margin-top: 0.6rem;
  }
  .scenario-tabs {
    display: flex;
    border-bottom: 1px solid #57624f;
  }
  .scenario-tabs > button {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    background: transparent;
    color: var(--dark-muted);
    padding: 1.1rem 1.3rem;
    font-size: 0.8rem;
    border: 1px solid transparent;
    border-bottom: 0;
    border-radius: 4px 4px 0 0;
    min-height: 56px;
  }
  .scenario-tabs > button[aria-selected='true'] {
    background: #30392c;
    border-color: #57624f;
    color: var(--paper);
  }
  .scenario-tabs > button:hover {
    color: var(--signal);
  }
  .scenario-tabs svg {
    width: 14px;
    height: 14px;
    margin-left: 0.65rem;
  }
  .tab-number {
    font: 0.58rem var(--mono);
    color: var(--dark-muted);
  }
  .workflow-panel {
    container: workflow / inline-size;
    background: #283124;
    border: 1px solid #57624f;
    border-top: 0;
    border-radius: 0 0 5px 5px;
    padding: 1.6rem 2rem 0;
  }
  .workflow-heading {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    color: var(--dark-muted);
  }
  .workflow-heading .eyebrow {
    font-size: 0.56rem;
    letter-spacing: 0.035em;
  }
  .local-label {
    display: inline-flex;
    gap: 0.5rem;
    align-items: center;
    white-space: nowrap;
    color: var(--signal);
  }
  .flow-path {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.25rem;
    margin-top: 2rem;
  }
  .flow-path > li {
    position: relative;
  }
  .flow-path > li:not(:last-child)::after {
    content: '';
    position: absolute;
    width: 1.25rem;
    height: 1px;
    background: #657059;
    right: -1.25rem;
    top: 50%;
  }
  .flow-path button {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    width: 100%;
    min-height: 58px;
    padding: 0.8rem 0.95rem;
    border: 1px solid #78806c;
    border-radius: 3px;
    background: transparent;
    color: var(--dark-muted);
    text-align: left;
    font-size: 0.74rem;
  }
  .flow-path button:disabled {
    cursor: default;
  }
  .flow-path button:hover:not(:disabled) {
    border-color: var(--signal);
    color: var(--paper);
  }
  .flow-path [data-active='true'] button {
    background: var(--signal);
    border-color: var(--signal);
    color: var(--ink);
  }
  .node-number {
    font: 0.58rem var(--mono);
    opacity: 0.85;
  }
  .gate-symbol {
    margin-left: auto;
    font-size: 1.1rem;
  }
  .lab-content {
    display: grid;
    grid-template-columns: 0.9fr 1.15fr;
    gap: clamp(1.5rem, 4vw, 4rem);
    padding: 2.5rem 0;
    align-items: start;
    min-height: 370px;
  }
  .stage-count {
    color: var(--signal);
    font-size: 0.56rem;
    margin-bottom: 1.1rem;
  }
  .stage-explanation h3 {
    font-size: clamp(1.4rem, 2.3vw, 2rem);
    line-height: 1.15;
    max-width: 21rem;
  }
  .stage-summary {
    color: var(--dark-muted);
    font-size: 0.8rem;
    line-height: 1.8;
    margin-top: 1rem;
    max-width: 24rem;
  }
  .stage-bullets {
    list-style: none;
    margin-top: 1.2rem;
    display: grid;
    gap: 0.55rem;
  }
  .stage-bullets li {
    position: relative;
    padding-left: 1.15rem;
    font-size: 0.71rem;
  }
  .stage-bullets li::before {
    content: '+';
    position: absolute;
    left: 0;
    color: var(--signal);
  }
  .approve-button {
    font-size: 0.74rem;
    margin-top: 1.4rem;
  }
  .artifact {
    min-width: 0;
    border: 1px solid #515d48;
    background: #1e261c;
    border-radius: 4px;
  }
  .artifact-bar {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.8rem 1rem;
    border-bottom: 1px solid #404c38;
    color: var(--dark-muted);
    font: 0.54rem var(--mono);
  }
  .artifact-dots {
    display: flex;
    gap: 4px;
  }
  .artifact-dots i {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: #849176;
  }
  .artifact-sample {
    margin-left: auto;
    font-size: 0.47rem;
    letter-spacing: 0.07em;
  }
  pre {
    margin: 0;
    padding: 1.3rem;
    min-height: 250px;
    font: 0.64rem/1.95 var(--mono);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    color: #dce2d3;
  }
  .artifact-footer {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.7rem 1rem;
    border-top: 1px solid #404c38;
    color: #b2bea6;
    font: 0.48rem var(--mono);
    letter-spacing: 0.05em;
  }
  .lab-controls {
    display: flex;
    gap: 1.5rem;
    align-items: center;
    justify-content: space-between;
    border-top: 1px solid #515d48;
    padding: 1.25rem 0;
  }
  .playback-controls {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-shrink: 0;
  }
  .run-button {
    min-width: 132px;
    min-height: 44px;
    padding: 0.75rem 1rem;
    font-size: 0.74rem;
  }
  .run-button:disabled {
    background: #46533c;
    color: #c7cfbd;
  }
  .step-button,
  .reset-button {
    background: transparent;
    color: var(--paper);
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.71rem;
    min-height: 44px;
    padding: 0.4rem 0.15rem;
  }
  .reset-button {
    color: var(--dark-muted);
  }
  .step-button:disabled {
    color: #a4ae98;
  }
  .step-button svg {
    width: 14px;
    height: 14px;
  }
  .step-button:hover:not(:disabled),
  .reset-button:hover {
    text-decoration: underline;
    text-underline-offset: 0.3rem;
  }
  .workflow-status {
    max-width: 23rem;
    font: 0.57rem/1.7 var(--mono);
    color: var(--dark-muted);
    text-align: right;
  }
  .lab-bottom {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    margin-top: 1.8rem;
    align-items: center;
  }
  .lab-bottom p {
    font: italic 1.5rem var(--serif);
  }
  .lab-bottom > span {
    font-size: 0.64rem;
    max-width: 24rem;
    text-align: right;
    color: var(--dark-muted);
  }
  .no-script-note {
    padding: 1rem;
    border: 1px solid #57624f;
    font-size: 0.8rem;
  }
  .static-stages {
    padding-top: 2rem;
  }
  .static-stages details {
    border-bottom: 1px solid #57624f;
    padding: 1rem 0;
  }
  .static-stages summary {
    padding-block: 0.5rem;
    font-size: 1rem;
  }
  .static-stages p {
    font-size: 0.8rem;
    line-height: 1.8;
    color: var(--dark-muted);
  }
  .static-stages pre {
    min-height: 0;
  }
  :is(button, a):focus-visible {
    outline-color: var(--signal);
  }
  @container lab (max-width: 45rem) {
    .scenario-tabs :is(svg, .tab-number) {
      display: none;
    }
    .scenario-tabs > button {
      flex: 1;
      padding-inline: clamp(8px, 2cqw, 20px);
    }
    .lab-heading {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.5rem;
    }
  }
  @container lab (max-width: 18rem) {
    .scenario-tabs {
      flex-direction: column;
    }
    .scenario-tabs > button {
      justify-content: flex-start;
      text-align: left;
      padding: 0.7rem;
      border-bottom: 1px solid #57624f;
    }
  }
  @container workflow (max-width: 24rem) {
    .flow-path {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .flow-path > li:nth-child(2)::after {
      display: none;
    }
  }
  @media (max-width: 900px) {
    .workflow-panel {
      padding-inline: 1.25rem;
    }
    .lab-controls {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
    }
    .workflow-status {
      text-align: left;
      max-width: unset;
    }
    .flow-path {
      gap: 0.6rem;
    }
    .flow-path > li:not(:last-child)::after {
      width: 0.6rem;
      right: -0.6rem;
    }
    .flow-path button {
      padding-inline: 0.65rem;
      font-size: 0.65rem;
    }
    .lab-heading > p {
      max-width: 19rem;
    }
  }
  @media (max-width: 680px) {
    .lab-topline {
      align-items: flex-start;
      flex-direction: column;
      gap: 1rem;
    }
    .lab-heading {
      align-items: flex-start;
      flex-direction: column;
      gap: 1.5rem;
      margin-bottom: 2rem;
    }
    .lab-heading > p {
      max-width: 29rem;
      font-size: 0.83rem;
    }
    .scenario-tabs {
      gap: 0;
    }
    .scenario-tabs > button {
      flex: 1;
      justify-content: center;
      padding: 0.8rem 0.35rem;
      gap: 0;
      font-size: 0.65rem;
      text-wrap: balance;
      text-align: center;
      min-width: 0;
    }
    .scenario-tabs :is(svg, .tab-number) {
      display: none;
    }
    .workflow-panel {
      padding: 1rem 0.9rem 0;
    }
    .workflow-heading {
      align-items: flex-start;
    }
    .workflow-heading > .eyebrow {
      max-width: 15rem;
      line-height: 1.8;
    }
    .workflow-heading .local-label {
      display: none;
    }
    .flow-path {
      margin-top: 1.2rem;
      gap: 0.45rem;
    }
    .flow-path button {
      flex-direction: column;
      align-items: flex-start;
      justify-content: center;
      gap: 0.3rem;
      padding: 0.6rem 0.4rem;
      min-height: 70px;
      font-size: 0.61rem;
    }
    .flow-path > li:not(:last-child)::after {
      width: 0.45rem;
      right: -0.45rem;
    }
    .gate-symbol {
      display: none;
    }
    .lab-content {
      grid-template-columns: 1fr;
      gap: 1.5rem;
      padding-block: 1.7rem;
      min-height: 0;
    }
    .stage-explanation h3 {
      font-size: 1.65rem;
    }
    pre {
      min-height: 235px;
      padding: 1rem 0.8rem;
      font-size: 0.6rem;
    }
    .artifact-bar {
      gap: 0.5rem;
      padding-inline: 0.75rem;
    }
    .artifact-dots {
      display: none;
    }
    .artifact-footer {
      padding-inline: 0.75rem;
      font-size: 0.44rem;
    }
    .playback-controls {
      width: 100%;
      gap: 0.7rem;
      flex-wrap: wrap;
    }
    .run-button {
      min-width: 111px;
      gap: 0.7rem;
      padding-inline: 0.7rem;
      font-size: 0.68rem;
    }
    .step-button,
    .reset-button {
      font-size: 0.66rem;
    }
    .lab-bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.8rem;
    }
    .lab-bottom > span {
      text-align: left;
    }
  }
</style>
