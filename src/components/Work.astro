---
import Arrow from './Arrow.astro';
---

<section id="projects" class="work wrap" aria-labelledby="work-title">
  <p class="eyebrow section-label">03 / SELECTED WORK</p>
  <div class="work-heading">
    <h2 id="work-title">Built, not just<br /><em>talked about.</em></h2><p>
      From an open-source agent desktop<br />to automation in the physical
      world.
    </p>
  </div>
  <div class="work-grid">
    <article class="project project-craft">
      <a
        class="project-art craft-art"
        href="https://github.com/craft-ai-agents/craft-agents-oss"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Explore Craft Agents on GitHub (opens in a new tab)"
      >
        <span class="art-eyebrow eyebrow"
          >OPEN SOURCE / A DIFFERENT WAY TO WORK</span
        >
        <div class="craft-composition" aria-hidden="true">
          <div class="craft-window window-back"></div><div
            class="craft-window window-mid"
          >
          </div><div class="craft-window window-front">
            <div class="window-line"><i></i><i></i><i></i></div><span
              class="craft-symbol">✳</span
            ><span class="craft-type">Craft<br />Agents<span>.</span></span
            ><span class="window-footer">CONTEXT + TOOLS + YOU</span>
          </div><span class="craft-orbit orbit-one"></span><span
            class="craft-orbit orbit-two"></span>
        </div>
        <span class="art-caption eyebrow">CONCEPT ILLUSTRATION</span><span
          class="art-arrow"><Arrow /></span
        >
      </a>
      <div class="project-info">
        <div class="project-meta">
          <span class="eyebrow">AGENT ENGINEERING</span><span class="eyebrow"
            >AT CRAFT DOCS</span
          >
        </div><h3>A better interface for working with AI.</h3><p>
          At Craft Docs, I helped build Craft Agents: an open-source desktop app
          bringing AI, tools, and documents into a connected workflow.
        </p><a
          class="text-link"
          href="https://github.com/craft-ai-agents/craft-agents-oss"
          target="_blank"
          rel="noopener noreferrer"
          >Explore Craft Agents <Arrow /><span class="sr-only">
            (opens in a new tab)</span
          ></a
        >
      </div>
    </article>
    <article class="project project-yabune">
      <a
        class="project-art home-art"
        href="https://yabune-home.hu/en/"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Explore Yabune Home (opens in a new tab)"
      >
        <span class="art-eyebrow eyebrow">REAL-WORLD AUTOMATION / YABUNE</span>
        <svg
          class="house-drawing"
          viewBox="0 0 450 320"
          fill="none"
          aria-hidden="true"
        >
          <g stroke="#484d37" stroke-width="1.3"
            ><path d="m70 175 151-91 154 89-153 91Z"></path><path
              d="m70 175 1 35 151 88 153-87v-38M222 264v34M125 144l151 88M177 112l151 90M123 206l149-90M173 235l150-91"
              opacity=".38"></path><path
              d="m119 171 100-60 105 59v67l-101 59-104-60Z"
              fill="#e8edb9"></path><path
              d="m119 171 100-91 105 90-101 60Z"
              fill="#f0f2cf"></path><path
              d="m119 171 104 60 101-61M223 231v65M174 204v62M273 201v66"
            ></path><path
              d="m143 204 18 10v26l-18-11ZM248 229l26-15v29l-26 15Z"
              fill="#ccdb8d"></path><path
              d="m281 211 18-11v28l-18 10Z"
              fill="#ccdb8d"></path></g
          >
          <g stroke="#484d37" stroke-width="1"
            ><path
              d="M74 98h46l28 27M329 102h-34l-13 19M371 264h-46l-31-28"
              stroke-dasharray="3 4"></path><circle
              cx="69"
              cy="98"
              r="5"
              fill="#e8ef61"></circle><circle
              cx="334"
              cy="102"
              r="5"
              fill="#e8ef61"></circle><circle
              cx="376"
              cy="264"
              r="5"
              fill="#e8ef61"></circle></g
          >
          <g fill="#484d37" font-size="8" font-family="monospace"
            ><text x="41" y="79">CONTEXT</text><text x="319" y="83"
              >CONTROL</text
            ><text x="336" y="287">COMFORT</text></g
          >
        </svg>
        <span class="art-caption eyebrow">CONCEPT ILLUSTRATION</span><span
          class="art-arrow"><Arrow /></span
        >
      </a>
      <div class="project-info">
        <div class="project-meta">
          <span class="eyebrow">CONNECTED SYSTEMS</span><span class="eyebrow"
            >CO-FOUNDER</span
          >
        </div><h3>Automation beyond the screen.</h3><p>
          At Yabune, the software meets the physical world. Smart-home systems
          and practical integrations built around the people who use them.
        </p><a
          class="text-link"
          href="https://yabune-home.hu/en/"
          target="_blank"
          rel="noopener noreferrer"
          >Discover Yabune Home <Arrow /><span class="sr-only">
            (opens in a new tab)</span
          ></a
        >
      </div>
    </article>
  </div>
  <a
    class="teaching-row"
    href="https://robotdreams.hu/course/215-okosotthon-tervezes"
    target="_blank"
    rel="noopener noreferrer"
    ><span class="teaching-mark" aria-hidden="true">↳</span><span
      ><span class="eyebrow">TEACHING / ROBOT DREAMS</span><span
        class="teaching-title">Knowledge that leaves the room.</span
      ></span
    ><span class="teaching-description"
      >Teaching smart-home design, protocols, and real implementations.</span
    ><Arrow /><span class="sr-only">View course (opens in a new tab)</span></a
  >
</section>
<style>
  .work {
    padding-block: clamp(4.5rem, 8vw, 8rem);
  }
  .work-heading {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 2rem;
    margin: 2rem 0 3rem;
  }
  .work-heading > p {
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.8;
  }
  .work-grid {
    display: grid;
    grid-template-columns: 1.16fr 1fr;
    gap: 2rem;
  }
  .project-art {
    display: block;
    position: relative;
    min-height: 370px;
    overflow: hidden;
    border-radius: 5px;
    isolation: isolate;
  }
  .craft-art {
    background: #d7dbc8;
  }
  .home-art {
    background: #e7e8d5;
  }
  .art-eyebrow {
    position: absolute;
    top: 1.4rem;
    left: 1.5rem;
    font-size: 0.5rem;
    z-index: 2;
  }
  .art-caption {
    position: absolute;
    bottom: 1.1rem;
    left: 1.5rem;
    font-size: 0.45rem;
    color: #535b48;
  }
  .art-arrow {
    position: absolute;
    right: 1.2rem;
    bottom: 1rem;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border: 1px solid #a5ad93;
    border-radius: 50%;
    transition: background 0.2s ease;
  }
  .project-art:hover .art-arrow {
    background: var(--signal);
  }
  .craft-composition {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
  }
  .craft-window {
    position: absolute;
    width: 215px;
    height: 255px;
    border: 1px solid #656e53;
    border-radius: 6px;
    box-shadow: 5px 10px 25px rgb(57 68 42 / 0.06);
  }
  .window-back {
    background: #c2c9ad;
    transform: translate(45px, -8px) rotate(15deg);
  }
  .window-mid {
    background: #e6eacb;
    transform: translate(19px, 0) rotate(6deg);
  }
  .window-front {
    background: #283124;
    color: #eaf0df;
    padding: 1rem 1.5rem;
    transform: translate(-12px, 8px) rotate(-7deg);
    transition: transform 0.4s var(--ease);
  }
  .project-art:hover .window-front {
    transform: translate(-20px, 2px) rotate(-10deg);
  }
  .window-line {
    display: flex;
    gap: 4px;
    padding-bottom: 0.8rem;
    border-bottom: 1px solid #626c55;
  }
  .window-line i {
    height: 4px;
    width: 4px;
    border-radius: 50%;
    background: #a8b597;
  }
  .craft-symbol {
    display: block;
    font-size: 2.7rem;
    line-height: 1;
    margin-top: 1.2rem;
    color: var(--signal);
  }
  .craft-type {
    display: block;
    font-size: 2.8rem;
    line-height: 0.96;
    letter-spacing: -0.065em;
    margin-top: 0.65rem;
  }
  .craft-type > span {
    color: var(--signal);
  }
  .window-footer {
    display: block;
    font: 0.42rem var(--mono);
    letter-spacing: 0.08em;
    color: #c4cfb6;
    margin-top: 1.4rem;
  }
  .craft-orbit {
    position: absolute;
    border: 1px solid #aab496;
    width: 360px;
    height: 195px;
    border-radius: 50%;
    z-index: -1;
  }
  .orbit-one {
    transform: rotate(35deg);
  }
  .orbit-two {
    transform: rotate(-35deg);
  }
  .house-drawing {
    width: 96%;
    height: 100%;
    position: absolute;
    inset: 0;
    margin: auto;
    transition: transform 0.4s var(--ease);
  }
  .home-art:hover .house-drawing {
    transform: translateY(-5px);
  }
  .project-info {
    padding-top: 1.4rem;
  }
  .project-meta {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    color: var(--muted);
  }
  .project-meta .eyebrow {
    font-size: 0.51rem;
  }
  .project-info h3 {
    font-size: clamp(1.45rem, 2.3vw, 2rem);
    margin-top: 0.9rem;
    max-width: 29rem;
  }
  .project-info > p {
    color: var(--muted);
    font-size: 0.85rem;
    line-height: 1.8;
    margin: 1rem 0 0.8rem;
    max-width: 31rem;
  }
  .project-info .text-link {
    font-size: 0.77rem;
  }
  .teaching-row {
    display: grid;
    grid-template-columns: 4rem 1fr 0.8fr 20px;
    align-items: center;
    gap: 1rem;
    border-block: 1px solid var(--line);
    margin-top: 3rem;
    padding: 1.75rem 0.25rem;
  }
  .teaching-mark {
    font-family: var(--serif);
    font-size: 3rem;
    line-height: 1;
  }
  .teaching-row .eyebrow {
    font-size: 0.55rem;
    color: var(--muted);
  }
  .teaching-title {
    display: block;
    font-size: 1.2rem;
    letter-spacing: -0.04em;
    margin-top: 0.35rem;
  }
  .teaching-description {
    font-size: 0.8rem;
    color: var(--muted);
    max-width: 19rem;
  }
  .teaching-row:hover .teaching-title {
    text-decoration: underline;
    text-underline-offset: 0.3rem;
  }
  @media (max-width: 680px) {
    .work-heading {
      align-items: flex-start;
      flex-direction: column;
      gap: 1.5rem;
    }
    .work-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .project-art {
      min-height: 325px;
    }
    .craft-window {
      width: 180px;
      height: 225px;
    }
    .craft-symbol {
      font-size: 2rem;
    }
    .craft-type {
      font-size: 2.4rem;
    }
    .window-footer {
      font-size: 0.37rem;
    }
    .project-info h3 {
      font-size: 1.65rem;
    }
    .teaching-row {
      grid-template-columns: 2rem 1fr 20px;
      gap: 0.8rem;
    }
    .teaching-description {
      grid-column: 2;
      grid-row: 2;
    }
    .teaching-mark {
      font-size: 2.3rem;
    }
    .teaching-row > svg {
      grid-column: 3;
      grid-row: 1;
    }
    .teaching-title {
      font-size: 1.1rem;
    }
  }
</style>
