---
import Arrow from './Arrow.astro';
import IsometricHome from './IsometricHome.astro';
---

<section id="projects" class="work wrap" aria-labelledby="work-title">
  <p class="eyebrow section-label">03 / SELECTED WORK</p>
  <div class="work-heading">
    <h2 id="work-title">Built, not just<br /><em>talked about.</em></h2><p>
      From an open-source agent desktop<br />to automation in the physical
      world.
    </p>
  </div>
  <div class="work-grid">
    <article class="project project-craft">
      <a
        class="project-art craft-art"
        href="https://thecraftagents.com"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Explore Craft Agents (opens in a new tab)"
      >
        <span class="art-eyebrow eyebrow"
          >OPEN SOURCE / A DIFFERENT WAY TO WORK</span
        >
        <div class="craft-composition" aria-hidden="true">
          <div class="craft-window window-back"></div><div
            class="craft-window window-mid"
          >
          </div><div class="craft-window window-front">
            <div class="window-line"><i></i><i></i><i></i></div><img
              class="craft-symbol"
              src="/brands/craft-agents.svg"
              width="48"
              height="48"
              alt=""
            /><span class="craft-type">Craft<br />Agents<span>.</span></span
            ><span class="window-footer">CONTEXT + TOOLS + YOU</span>
          </div><span class="craft-orbit orbit-one"></span><span
            class="craft-orbit orbit-two"></span>
        </div>
        <span class="art-caption eyebrow">CONCEPT ILLUSTRATION</span><span
          class="art-arrow"><Arrow /></span
        >
      </a>
      <div class="project-info">
        <div class="project-brand craft-brand">
          <img
            src="/brands/craft-agents.svg"
            width="28"
            height="28"
            alt=""
            loading="lazy"
          /><span>Craft Agents</span>
        </div>
        <div class="project-meta">
          <span class="eyebrow">AGENT ENGINEERING</span><span class="eyebrow"
            >AT CRAFT DOCS</span
          >
        </div><h3>A better interface for working with AI.</h3><p>
          At Craft Docs, I helped build Craft Agents: an open-source desktop app
          bringing AI, tools, and documents into a connected workflow.
        </p>
        <div class="project-links">
          <a
            class="text-link"
            href="https://thecraftagents.com"
            target="_blank"
            rel="noopener noreferrer"
            >Explore Craft Agents <Arrow /><span class="sr-only">
              (opens in a new tab)</span
            ></a
          >
          <a
            class="text-link source-link"
            href="https://github.com/craft-ai-agents/craft-agents-oss"
            target="_blank"
            rel="noopener noreferrer"
            >Craft Agents source on GitHub <Arrow /><span class="sr-only">
              (opens in a new tab)</span
            ></a
          >
        </div>
      </div>
    </article>
    <article class="project project-yabune">
      <a
        class="project-art home-art"
        href="https://yabune-home.hu/en/"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Explore Yabune Home (opens in a new tab)"
      >
        <span class="art-eyebrow eyebrow">REAL-WORLD AUTOMATION / YABUNE</span>
        <div class="home-composition"><IsometricHome /></div>
        <span class="art-caption eyebrow">CONCEPT ILLUSTRATION</span><span
          class="art-arrow"><Arrow /></span
        >
      </a>
      <div class="project-info">
        <div class="project-brand">
          <img
            class="yabune-wordmark"
            src="/brands/yabune-solutions.png"
            width="2941"
            height="805"
            alt=""
            loading="lazy"
          />
        </div>
        <div class="project-meta">
          <span class="eyebrow">CONNECTED SYSTEMS</span><span class="eyebrow"
            >CO-FOUNDER</span
          >
        </div><h3>Automation beyond the screen.</h3><p>
          At Yabune, the software meets the physical world. Smart-home systems
          and practical integrations built around the people who use them.
        </p><a
          class="text-link"
          href="https://yabune-home.hu/en/"
          target="_blank"
          rel="noopener noreferrer"
          >Discover Yabune Home <Arrow /><span class="sr-only">
            (opens in a new tab)</span
          ></a
        >
      </div>
    </article>
  </div>
  <a
    class="teaching-row"
    href="https://robotdreams.hu/course/215-okosotthon-tervezes"
    target="_blank"
    rel="noopener noreferrer"
    ><span class="teaching-mark" aria-hidden="true">↳</span><span
      ><span class="eyebrow">TEACHING / ROBOT DREAMS</span><span
        class="teaching-title">Knowledge that leaves the room.</span
      ></span
    ><span class="teaching-description"
      >Teaching smart-home design, protocols, and real implementations.</span
    ><Arrow /><span class="sr-only">View course (opens in a new tab)</span></a
  >
</section>
<style>
  .work {
    padding-block: clamp(4.5rem, 8vw, 8rem);
  }
  .work-heading {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 2rem;
    margin: 2rem 0 3rem;
  }
  .work-heading > p {
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.8;
  }
  .work-grid {
    display: grid;
    grid-template-columns: 1.16fr 1fr;
    gap: 2rem;
  }
  .project-art {
    display: grid;
    grid-template-rows: auto minmax(255px, 1fr) auto;
    gap: 1rem;
    padding: 1.4rem 1.5rem 1.1rem;
    position: relative;
    min-height: 370px;
    overflow: hidden;
    border-radius: 5px;
    isolation: isolate;
  }
  .craft-art {
    background: #d7dbc8;
  }
  .home-art {
    background: #e7e8d5;
  }
  .art-eyebrow {
    font-size: 0.5rem;
    z-index: 2;
  }
  .art-caption {
    padding-right: 3rem;
    font-size: 0.45rem;
    color: #535b48;
  }
  .art-arrow {
    position: absolute;
    right: 1.2rem;
    bottom: 1rem;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border: 1px solid #a5ad93;
    border-radius: 50%;
    transition: background 0.2s ease;
  }
  .project-art:hover .art-arrow {
    background: var(--signal);
  }
  .craft-composition {
    position: relative;
    margin-inline: -1.5rem;
    display: grid;
    place-items: center;
  }
  .craft-window {
    position: absolute;
    width: 215px;
    height: 255px;
    border: 1px solid #656e53;
    border-radius: 6px;
    box-shadow: 5px 10px 25px rgb(57 68 42 / 0.06);
  }
  .window-back {
    background: #c2c9ad;
    transform: translate(45px, -8px) rotate(15deg);
  }
  .window-mid {
    background: #e6eacb;
    transform: translate(19px, 0) rotate(6deg);
  }
  .window-front {
    background: #283124;
    color: #eaf0df;
    padding: 16px 24px;
    transform: translate(-12px, 8px) rotate(-7deg);
    transition: transform 0.4s var(--ease);
  }
  .project-art:hover .window-front {
    transform: translate(-20px, 2px) rotate(-10deg);
  }
  .window-line {
    display: flex;
    gap: 4px;
    padding-bottom: 13px;
    border-bottom: 1px solid #626c55;
  }
  .window-line i {
    height: 4px;
    width: 4px;
    border-radius: 50%;
    background: #a8b597;
  }
  .craft-symbol {
    display: block;
    width: 48px;
    height: 48px;
    margin-top: 18px;
    padding: 4px;
    border-radius: 9px;
    background: #f2efdf;
  }
  .craft-type {
    display: block;
    font-size: 44px;
    line-height: 0.96;
    letter-spacing: -0.065em;
    margin-top: 10px;
  }
  .craft-type > span {
    color: var(--signal);
  }
  .window-footer {
    display: block;
    font: 7px var(--mono);
    letter-spacing: 0.08em;
    color: #c4cfb6;
    margin-top: 18px;
  }
  .craft-orbit {
    position: absolute;
    border: 1px solid #aab496;
    width: 360px;
    height: 195px;
    border-radius: 50%;
    z-index: -1;
  }
  .orbit-one {
    transform: rotate(35deg);
  }
  .orbit-two {
    transform: rotate(-35deg);
  }
  .home-composition {
    position: relative;
    margin-inline: -1.5rem;
    min-height: 255px;
  }
  .home-composition :global(.house-drawing) {
    position: absolute;
    inset: 0;
  }
  .project-brand {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    min-height: 44px;
    margin-bottom: 1rem;
    font-size: 1.05rem;
    font-weight: 500;
    letter-spacing: -0.035em;
  }
  .project-brand img {
    flex-shrink: 0;
  }
  .yabune-wordmark {
    width: 160px;
    max-width: 100%;
    height: auto;
  }
  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem 1.2rem;
    align-items: center;
  }
  .project-links .source-link {
    color: var(--muted);
  }
  .project-info {
    padding-top: 1.4rem;
  }
  .project-meta {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    flex-wrap: wrap;
    color: var(--muted);
  }
  .project-meta .eyebrow {
    font-size: 0.51rem;
  }
  .project-info h3 {
    font-size: clamp(1.45rem, 2.3vw, 2rem);
    margin-top: 0.9rem;
    max-width: 29rem;
  }
  .project-info > p {
    color: var(--muted);
    font-size: 0.85rem;
    line-height: 1.8;
    margin: 1rem 0 0.8rem;
    max-width: 31rem;
  }
  .project-info .text-link {
    font-size: 0.77rem;
    max-width: 100%;
    overflow-wrap: anywhere;
  }
  .teaching-row {
    display: grid;
    grid-template-columns: 4rem 1fr 0.8fr 20px;
    align-items: center;
    gap: 1rem;
    border-block: 1px solid var(--line);
    margin-top: 3rem;
    padding: 1.75rem 0.25rem;
  }
  .teaching-mark {
    font-family: var(--serif);
    font-size: 3rem;
    line-height: 1;
  }
  .teaching-row .eyebrow {
    font-size: 0.55rem;
    color: var(--muted);
  }
  .teaching-title {
    display: block;
    font-size: 1.2rem;
    letter-spacing: -0.04em;
    margin-top: 0.35rem;
  }
  .teaching-description {
    font-size: 0.8rem;
    color: var(--muted);
    max-width: 19rem;
  }
  .teaching-row:hover .teaching-title {
    text-decoration: underline;
    text-underline-offset: 0.3rem;
  }
  @media (max-width: 680px) {
    .work-heading {
      align-items: flex-start;
      flex-direction: column;
      gap: 1.5rem;
    }
    .work-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .project-art {
      min-height: 325px;
    }
    .craft-window {
      width: 180px;
      height: 225px;
    }
    .craft-symbol {
      width: 40px;
      height: 40px;
      margin-top: 12px;
    }
    .craft-type {
      font-size: 38px;
    }
    .window-footer {
      font-size: 6px;
      margin-top: 16px;
    }
    .project-info h3 {
      font-size: 1.65rem;
    }
    .teaching-row {
      grid-template-columns: 2rem 1fr 20px;
      gap: 0.8rem;
    }
    .teaching-description {
      grid-column: 2;
      grid-row: 2;
    }
    .teaching-mark {
      font-size: 2.3rem;
    }
    .teaching-row > svg {
      grid-column: 3;
      grid-row: 1;
    }
    .teaching-title {
      font-size: 1.1rem;
    }
  }
  @media (max-width: 400px) {
    .teaching-row {
      grid-template-columns: minmax(0, 1fr) 20px;
    }
    .teaching-mark {
      display: none;
    }
    .teaching-description {
      grid-column: 1;
    }
    .teaching-row > svg {
      grid-column: 2;
    }
  }
</style>
